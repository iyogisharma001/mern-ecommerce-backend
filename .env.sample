

PORT=4000

MONGO_URI= 

REDIS_URI=

STRIPE_KEY=

CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Frontend URL(s) allowed by CORS, comma-separated, no trailing slash
# e.g. CLIENT_URL=http://localhost:5173,https://my-shop.vercel.app
CLIENT_URL=

# Stripe webhook signing secret (Dashboard -> Developers -> Webhooks)
# Endpoint: POST <your-server>/api/v1/payment/webhook, event: payment_intent.succeeded
STRIPE_WEBHOOK_SECRET=

# Firebase Admin service account (Firebase console -> Project settings -> Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# keep the quotes and the \n characters exactly as in the downloaded JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
